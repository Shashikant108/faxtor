# Copy to .env.local and fill in.

# Mailchimp: every contact form inquiry is added to this audience (lib/mailchimp.ts).
# API key: Mailchimp > Profile > Extras > API keys. Audience ID: Audience > Settings > Audience name and defaults.
# Server: the part after the dash at the end of the API key, like us2.
# Besides Mailchimp's default fields, the audience needs two text fields, SERVICE and MESSAGE, so what the visitor
# is looking for and their message show in each contact's details.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER=

# Optional: also send each inquiry as JSON to this URL (a CRM, email service or automation webhook).
# With neither Mailchimp nor this set, the form opens the visitor's email app instead.
CONTACT_WEBHOOK_URL=
